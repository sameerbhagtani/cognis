{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],

        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "moduleDetection": "force",

        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "verbatimModuleSyntax": true
    }
}
