{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "moduleDetection": "force",

        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,

        "jsx": "react-jsx",
        "types": ["vite/client"]
    },
    "include": ["src", "vite.config.ts"]
}
