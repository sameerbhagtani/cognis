{
    "name": "cognis",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.3.4",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "start": "turbo run start",
        "lint": "turbo run lint",
        "check-types": "turbo run check-types",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "clean": "rimraf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.turbo packages/*/.turbo apps/*/.astro apps/*/.expo apps/*/dist packages/*/dist",
        "db:up": "docker compose up -d",
        "db:down": "docker compose down",
        "db:restart": "docker compose restart postgres",
        "db:logs": "docker compose logs -f postgres",
        "db:reset": "docker compose down -v && docker compose up -d",
        "db:generate": "turbo run db:generate --filter=@cognis/database",
        "db:migrate": "turbo run db:migrate --filter=@cognis/database",
        "db:push": "turbo run db:push --filter=@cognis/database",
        "prepare": "husky"
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rimraf": "^6.1.3",
        "turbo": "^2.10.12"
    }
}
