meta {
  name: Reset Password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{clientUrl}}
}

body:json {
  {
    "token": "paste-token-from-email",
    "newPassword": "newPassword456"
  }
}

docs {
  Consumes the token from the reset mail and sets the new password.
}
