{
    "cli": {
        "version": ">= 24.7.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "distribution": "internal",
            "pnpm": "12.3.4",
            "autoIncrement": true,
            "env": {
                "EXPO_PUBLIC_SERVER_URL": "https://api.cognis.in"
            },
            "android": {
                "buildType": "apk"
            }
        }
    }
}
