# Copy to deploy/.env and fill in. Never commit the real file.

# Database. Only reachable from inside the stack, never published.
# Generate the password with: openssl rand -hex 24
# (hex, so it's safe to drop into a connection URL as-is)
POSTGRES_USER=cognis
POSTGRES_PASSWORD=
POSTGRES_DB=cognis

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

OPENAI_API_KEY=

BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Cognis

TRASH_RETENTION_DAYS=30
